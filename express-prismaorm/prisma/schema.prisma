// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// Users
// Artists
// 1 to m
// Albums
// m to m (connector)
// Songs
// Playlists (connector Users & Songs)

model User{
  id            String      @id @default(uuid())
  username      String 
  password      String 
  email         String 
  phoneNumber   String?

  playlists Playlist[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model Artist{
  id              String      @id @default(uuid())
  name            String 
  genre           String 
  firstDebutYear  Int 
  country         String 
  description     String

  // Relasi ONE
  albums Album[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("artists")
}

model Album{
  id              String      @id @default(uuid())
  title           String 
  releaseYear     Int 
  genre           String 

  // Relasi MANY
  artistsId       String 
  artists Artist @relation(fields: [artistsId], references: [id])

  songs Song[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("albums")
}

model Song{
  id              String      @id @default(uuid())
  title           String 
  releaseYear     Int 
  duration        String 
  genre           String 

  albumsId        String 
  albums Album @relation(fields: [albumsId], references: [id])

  playlists Playlist[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("songs")
}

model Playlist{
  songsId       String @unique
  songs Song @relation(fields: [songsId], references: [id])

  usersId       String @unique 
  users User @relation(fields: [usersId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("playlists")
}