// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Sample {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("samples") // if you want to use snake_case format
}

model Employee{
  id String @id @default(uuid())
  name String
  email String
  password String
  phone String
  salary Int
  leaveBalance Int
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  shiftId Int
  shifts Shift @relation(fields:[shiftId], references: [id])
  roleId Int
  roles Role @relation(fields: [roleId], references: [id])

  requestBy Leave[] @relation("requestBy")
  accBy Leave[] @relation("accBy")

  attendance Attendance[]

  @@map("employees")
}

model Role{
  id Int @id @default(autoincrement()) 
  title String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  employees Employee[]

  @@map("roles")
}

model Shift{
  id Int @id @default(autoincrement()) 
  shiftStart String
  shiftEnd String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  employees Employee[]

  @@map("shifts")
}

model Leave{
  id Int @id @default(autoincrement()) 
  startDate DateTime
  endDate DateTime
  description String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  employeeReqId String
  requestBy Employee @relation("requestBy", fields: [employeeReqId], references: [id])

  employeeAccId String?
  accBy Employee? @relation("accBy", fields: [employeeAccId], references: [id])

  leaveTypeId Int @unique
  leaveTypes LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@map("leaves")
}

model LeaveType{
  id Int @id @default(autoincrement()) 
  type String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  leave Leave[]

  @@map("leave_types")
}

model Attendance{
  id Int @id @default(autoincrement()) 
  clockIn DateTime
  clockOut DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  employeeId String
  employees Employee @relation(fields: [employeeId], references: [id])

  @@map("attendances")
}